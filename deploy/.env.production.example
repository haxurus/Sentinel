# Non-secret production settings. Application secrets live in /srv/docker/sentinel/secrets.
DISCORD_CLIENT_ID=123456789012345678
# Comma-separated Discord user IDs allowed to install this hosted bot.
# Empty means nobody can obtain an install link from the hosted site.
INVITE_ALLOWED_USER_IDS=
PUBLIC_BASE_URL=https://sentinel.example.com/backend
WEB_URL=https://sentinel.example.com
POSTGRES_ADMIN_USER=sentinel_owner
POSTGRES_DB=sentinel_audit
LOG_LEVEL=info
